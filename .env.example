# Sao chép thành .env rồi sửa. server tự đọc file .env khi chạy (npm start / pm2).

# Cổng & địa chỉ lắng nghe. Sau reverse proxy (Caddy) nên để 127.0.0.1 để không lộ cổng ra ngoài.
PORT=3000
HOST=127.0.0.1
# Đang chạy sau Caddy/nginx (HTTPS): bật để cookie có cờ Secure và lấy đúng IP khách
TRUST_PROXY=1

# Tài khoản admin tạo ở lần chạy đầu (sau đó đổi mật khẩu trong web)
ACCESS_USER=admin
ACCESS_PASSWORD=

# Khóa mã hóa dữ liệu slot. Để trống = tự sinh data/secret.key. MẤT KHÓA = MẤT DỮ LIỆU SLOT.
SECRET_KEY=

# Cho khách tự đăng ký (tài khoản mới chưa có gói, admin cấp gói sau)
ALLOW_REGISTER=true
# Chỉ bật khi mỗi slot đã chạy trong sandbox: file .jar là code chạy thẳng trên máy chủ
ALLOW_USER_UPLOAD=false

# Tổng số tab chạy cùng lúc trên máy chủ. Để trống = tự tính theo RAM (~160MB/tab)
MAX_TOTAL_RUNNING=

# Hiện cho khách chưa có gói / hết hạn
CONTACT_INFO=Liên hệ Zalo 09xx.xxx.xxx để mua gói.

# Số ngày giữ bản sao lưu trong data/backups
BACKUP_KEEP_DAYS=7

# ---- Nạp tiền tự động (chuyển khoản VietQR) ----
# Mã ngân hàng theo VietQR (MB, VCB, ACB, TCB, BIDV... hoặc BIN 970422), số TK, tên chủ TK (không dấu, in hoa)
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
# Tiền tố mã nạp trong nội dung chuyển khoản, vd. TREO -> khách ghi TREO7K3QX9
PAY_PREFIX=TREO
# SePay: Webhook URL = https://ten-mien/webhooks/sepay, kiểu xác thực "API Key", dán cùng key ở đây
SEPAY_API_KEY=
# Casso: Webhook URL = https://ten-mien/webhooks/casso
# Webhook V2 dùng "Khóa bảo mật" (checksum key); webhook cũ dùng secure-token
CASSO_CHECKSUM_KEY=
CASSO_SECURE_TOKEN=
# Bảng giá: sửa trong pricing.js hoặc tạo data/pricing.json
